# Database Connection (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/exam_grading_db

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Storage Directories
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Server Settings
DEBUG=True
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100
